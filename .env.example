# Copier ce fichier en .env et renseigner les valeurs.
# Le .env réel n'est jamais versionné.

# ── Base de données ────────────────────────────────────────────────────────
# Lue par prisma.config.mjs (migrations) et par l'adapter du client applicatif.
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/boutique_db"

# ── Sessions ───────────────────────────────────────────────────────────────
# Rien à configurer. Le cookie de session ne porte qu'un jeton aléatoire de 32
# octets ; l'identité vit en base, ce qui permet de révoquer une session
# immédiatement — ce qu'un jeton signé (JWT) ne permet pas. Il n'y a donc aucun
# secret de signature à fournir.

# ── Compte administrateur ──────────────────────────────────────────────────
# Créé par `npm run db:seed`. Si ADMIN_PASSWORD est vide, le seed tire un mot de
# passe au hasard et l'affiche une seule fois dans la console.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Adresse publique du site ───────────────────────────────────────────────
# Sert aux URL de retour de Stripe. Facultative : sans elle, l'adresse est
# déduite des en-têtes de la requête. À renseigner derrière un proxy ou un
# conteneur, où l'en-tête `host` n'est pas le domaine public.
# NEXT_PUBLIC_SITE_URL="https://antre-du-vieux-geek.fr"

# ── Paiement ───────────────────────────────────────────────────────────────
# Sans STRIPE_SECRET_KEY, le tunnel reste ouvert mais n'encaisse rien : la
# commande est enregistrée en attente de paiement et l'écran le dit.
# STRIPE_SECRET_KEY=""
#
# Signature des webhooks. En développement, la valeur est affichée par :
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# En production, elle vient du tableau de bord Stripe, à la création du
# webhook pointant sur https://<domaine>/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=""
#
# PayPal n'a pas de clés à lui : il est encaissé par Stripe. Même session, même
# webhook, même solde — l'acheteur choisit seulement une autre façon de payer, et
# le paiement est enregistré en STRIPE. Il n'y a donc rien à renseigner ici : il
# suffit d'activer PayPal dans le tableau de bord Stripe, à
# Réglages → Moyens de paiement. Sans cette activation côté Stripe, choisir
# PayPal au tunnel fait échouer l'ouverture de la session de paiement.

# ── Ouvrages numériques ────────────────────────────────────────────────────
# Dossier où sont rangés les fichiers vendus. Il ne doit JAMAIS être servi
# directement par le serveur web : chaque octet passe par un contrôle de droit.
#
# Obligatoire pour vendre des ouvrages numériques, et volontairement sans valeur
# par défaut : en production, ce dossier doit être sur un volume persistant. Un
# défaut « quelque part dans le projet » se ferait effacer au premier
# redéploiement, avec les fichiers vendus dedans.
#
# En développement, `.stockage/numerique` convient — il est ignoré par git.
# DIGITAL_STORAGE_DIR=".stockage/numerique"

# ── Ménage programmé ───────────────────────────────────────────────────────
# Secret attendu par /api/cron/menage (purge des jetons, sessions et paniers
# invités périmés). Sans lui, la route refuse tout appel — un oubli ne doit pas
# laisser une route d'écriture ouverte. En générer un avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# L'ordonnanceur l'envoie en en-tête : Authorization: Bearer <valeur>
# CRON_SECRET=""

# ── Images distantes ───────────────────────────────────────────────────────
# Domaines autorisés pour les photos de produits, séparés par des virgules.
# Next refuse toute image venant d'ailleurs : son optimiseur va chercher l'URL
# depuis le serveur, une liste ouverte en ferait un relais de requêtes.
# NEXT_PUBLIC_IMAGE_HOSTS="images.exemple.fr,cdn.autre.com"

# ── E-mails transactionnels ────────────────────────────────────────────────
# Sans ces variables, aucun e-mail ne part : les messages sont écrits dans la
# console du serveur et le reste du site fonctionne normalement.
# Clé d'API Resend (https://resend.com) :
# RESEND_API_KEY=""
# Expéditeur — le domaine doit être vérifié chez le prestataire, sinon les
# messages partent en indésirables :
# EMAIL_FROM="L'antre du vieux geek fou <bonjour@antre-geek.fr>"
# Adresse de réponse, si différente de l'expéditeur :
# EMAIL_REPLY_TO=""

# ── Connexion Google (parcours « Continuer avec Google ») ──────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
