# Copier ce fichier en .env et renseigner les valeurs.
# Le .env réel n'est jamais versionné.

# ── Base de données ────────────────────────────────────────────────────────
# Lue par prisma.config.mjs (migrations) et par l'adapter du client applicatif.
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/boutique_db"

# ── Sessions ───────────────────────────────────────────────────────────────
# Secret de signature des cookies de session. En générer un avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# ── Compte administrateur ──────────────────────────────────────────────────
# Créé par `npm run db:seed`. Si ADMIN_PASSWORD est vide, le seed tire un mot de
# passe au hasard et l'affiche une seule fois dans la console.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Paiement (à renseigner le moment venu) ─────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# PAYPAL_CLIENT_ID=""
# PAYPAL_CLIENT_SECRET=""

# ── Connexion Google (parcours « Continuer avec Google ») ──────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
